	variables
	{
		thisapp.variables.OpenAI_Model = "gpt-4o-mini";
	}

		 functions
		 {
			 Deluge
			 {
				 string askCampusAI(string question)
                 {
                 	if(question == null || question.trim() == "")
                 	{
                 		return "Please enter a sustainability question.";
                 	}
                 	q = question.toLowerCase().trim();
                 	// =====================================
                 	// 1. ENERGY ANALYTICS
                 	// =====================================
                 	energyTotal = 0.0;
                 	co2Total = 0.0;
                 	energyCount = 0;
                 	highCount = 0;
                 	highestEnergy = 0.0;
                 	lowestEnergy = 0.0;
                 	highestID = "";
                 	lowestID = "";
                 	energyDetails = "";
                 	for each  rec in Energy_Consumption[ID != 0]
                 	{
                 		units = ifnull(rec.Units_Consumed_kWh,0.0);
                 		co2 = ifnull(rec.Estimated_CO,0.0);
                 		energyCount = energyCount + 1;
                 		energyTotal = energyTotal + units;
                 		co2Total = co2Total + co2;
                 		if(energyCount == 1)
                 		{
                 			highestEnergy = units;
                 			lowestEnergy = units;
                 			highestID = rec.ID.toString();
                 			lowestID = rec.ID.toString();
                 		}
                 		else
                 		{
                 			if(units > highestEnergy)
                 			{
                 				highestEnergy = units;
                 				highestID = rec.ID.toString();
                 			}
                 			if(units < lowestEnergy)
                 			{
                 				lowestEnergy = units;
                 				lowestID = rec.ID.toString();
                 			}
                 		}
                 		if(units >= 500)
                 		{
                 			highCount = highCount + 1;
                 		}
                 		energyDetails = energyDetails + "\nRecord ID: " + rec.ID.toString() + "\nEnergy: " + units.toString() + " kWh" + "\nEstimated CO2: " + co2.toString() + "\n----------------------";
                 	}
                 	energyAverage = 0.0;
                 	if(energyCount > 0)
                 	{
                 		energyAverage = energyTotal / energyCount;
                 	}
                 	// =====================================
                 	// 2. GREETING
                 	// =====================================
                 	if(q == "hi" || q == "hello" || q == "hey" || q == "good morning" || q == "good afternoon")
                 	{
                 		return "Welcome to the Campus Sustainability Assistant!\n" + "Ask about electricity, energy, carbon emissions, water, waste, " + "green activities, student participation, complaints, or sustainability recommendations.";
                 	}
                 	// =====================================
                 	// 3. ELECTRICITY-SAVING RECOMMENDATIONS
                 	// =====================================
                 	if(q.contains("electricity") || q.contains("save power") || q.contains("saving power") || q.contains("electrical energy"))
                 	{
                 		if(q.contains("save") || q.contains("reduce") || q.contains("conserve") || q.contains("recommend") || q.contains("how can") || q.contains("suggest"))
                 		{
                 			return "ELECTRICITY-SAVING RECOMMENDATIONS\n" + "1. Switch off lights, fans, and equipment when not in use.\n" + "2. Replace conventional bulbs with energy-efficient LED lights.\n" + "3. Use natural daylight whenever possible.\n" + "4. Set air conditioners to a moderate temperature and clean filters regularly.\n" + "5. Monitor building-wise energy consumption to identify excessive usage.\n" + "6. Encourage students and staff to report faulty electrical equipment.\n" + "7. Review the campus energy dashboard regularly to track improvements.";
                 		}
                 	}
                 	// =====================================
                 	// 4. WATER CONSUMPTION
                 	// =====================================
                 	if(q.contains("water"))
                 	{
                 		if(q.contains("recommend") || q.contains("reduce") || q.contains("save") || q.contains("conserve") || q.contains("how can") || q.contains("suggest"))
                 		{
                 			return "WATER-SAVING RECOMMENDATIONS\n" + "1. Repair leaking taps and pipes promptly.\n" + "2. Install water-efficient taps and fixtures.\n" + "3. Monitor water meters regularly.\n" + "4. Reuse suitable water for gardening where safe.\n" + "5. Avoid unnecessary water use in washrooms and laboratories.\n" + "6. Encourage students and staff to report leaks.";
                 		}
                 		waterCount = 0;
                 		waterDetails = "";
                 		for each  w in Water_Consumption[ID != 0]
                 		{
                 			waterCount = waterCount + 1;
                 			waterDetails = waterDetails + "\nWater record ID: " + w.ID.toString() + "\n----------------------";
                 		}
                 		return "WATER CONSUMPTION RECORDS\n" + "Records found: " + waterCount + "\n" + waterDetails + "\nWater quantity totals require your actual quantity field name.";
                 	}
                 	// =====================================
                 	// 5. WASTE MANAGEMENT
                 	// =====================================
                 	if(q.contains("waste") || q.contains("recycl") || q.contains("garbage") || q.contains("rubbish"))
                 	{
                 		if(q.contains("recommend") || q.contains("reduce") || q.contains("manage") || q.contains("suggest") || q.contains("how can") || q.contains("recycle"))
                 		{
                 			return "WASTE-REDUCTION RECOMMENDATIONS\n" + "1. Provide clearly labelled recycling bins.\n" + "2. Reduce single-use plastics on campus.\n" + "3. Compost suitable food and garden waste.\n" + "4. Encourage reusable bottles, bags, and containers.\n" + "5. Separate recyclable and non-recyclable waste.\n" + "6. Track waste quantities to measure improvement.";
                 		}
                 		wasteCount = 0;
                 		wasteDetails = "";
                 		for each  ws in Waste_Management[ID != 0]
                 		{
                 			wasteCount = wasteCount + 1;
                 			wasteDetails = wasteDetails + "\nWaste record ID: " + ws.ID.toString() + "\n----------------------";
                 		}
                 		return "WASTE MANAGEMENT RECORDS\n" + "Records found: " + wasteCount + "\n" + wasteDetails + "\nWaste quantity totals require your actual quantity field name.";
                 	}
                 	// =====================================
                 	// 6. GREEN ACTIVITIES
                 	// =====================================
                 	if(q.contains("green activit") || q.contains("tree planting") || q.contains("plantation") || q.contains("cleanup") || q.contains("clean-up") || q.contains("environmental event"))
                 	{
                 		if(q.contains("recommend") || q.contains("suggest") || q.contains("idea") || q.contains("how can"))
                 		{
                 			return "GREEN ACTIVITY IDEAS\n" + "1. Organize tree-planting events.\n" + "2. Conduct campus cleanup drives.\n" + "3. Organize environmental awareness sessions.\n" + "4. Encourage reusable bottles and bags.\n" + "5. Arrange campus recycling campaigns.\n" + "6. Invite students to participate in sustainability projects.";
                 		}
                 		activityCount = 0;
                 		activityDetails = "";
                 		for each  ga in Green_Activities[ID != 0]
                 		{
                 			activityCount = activityCount + 1;
                 			activityDetails = activityDetails + "\nActivity record ID: " + ga.ID.toString() + "\n----------------------";
                 		}
                 		return "GREEN ACTIVITIES\n" + "Activity records found: " + activityCount + "\n" + activityDetails;
                 	}
                 	// =====================================
                 	// 7. STUDENT PARTICIPATION
                 	// =====================================
                 	if(q.contains("student") || q.contains("participation") || q.contains("participants") || q.contains("volunteer"))
                 	{
                 		participationCount = 0;
                 		participationDetails = "";
                 		for each  st in Student_Participation[ID != 0]
                 		{
                 			participationCount = participationCount + 1;
                 			participationDetails = participationDetails + "\nParticipation record ID: " + st.ID.toString() + "\n----------------------";
                 		}
                 		return "STUDENT PARTICIPATION\n" + "Participation records found: " + participationCount + "\n" + participationDetails + "\nThis counts records, not necessarily unique students.";
                 	}
                 	// =====================================
                 	// 8. SUSTAINABILITY COMPLAINTS
                 	// =====================================
                 	if(q.contains("complaint") || q.contains("pending") || q.contains("resolved") || q.contains("reported problem"))
                 	{
                 		complaintCount = 0;
                 		complaintDetails = "";
                 		for each  cp in Sustainability_Complaints[ID != 0]
                 		{
                 			complaintCount = complaintCount + 1;
                 			complaintDetails = complaintDetails + "\nComplaint record ID: " + cp.ID.toString() + "\n----------------------";
                 		}
                 		return "SUSTAINABILITY COMPLAINTS\n" + "Total complaint records: " + complaintCount + "\n" + complaintDetails + "\nPending and resolved totals require your actual status field name.";
                 	}
                 	// =====================================
                 	// 9. ENERGY RECORDS
                 	// =====================================
                 	if((q.contains("energy") && q.contains("all") || q.contains("records") || q.contains("list") || q.contains("show") || q.contains("display")) || q.contains("energy details"))
                 	{
                 		return "ENERGY CONSUMPTION RECORDS\n" + "Records found: " + energyCount + "\n" + "Total energy: " + energyTotal + " kWh\n" + energyDetails;
                 	}
                 	// =====================================
                 	// 10. ENERGY AND CARBON ANALYTICS
                 	// =====================================
                 	if(q.contains("energy") || q.contains("electricity") || q.contains("consumption") || q.contains("kwh") || q.contains("carbon") || q.contains("co2") || q.contains("emission"))
                 	{
                 		if(q.contains("highest") || q.contains("maximum") || q.contains("most energy") || q.contains("peak"))
                 		{
                 			if(energyCount == 0)
                 			{
                 				return "No energy records are available for analysis.";
                 			}
                 			return "HIGHEST ENERGY CONSUMPTION\n" + "Energy: " + highestEnergy + " kWh\n" + "Record ID: " + highestID;
                 		}
                 		if(q.contains("lowest") || q.contains("minimum") || q.contains("least energy"))
                 		{
                 			if(energyCount == 0)
                 			{
                 				return "No energy records are available for analysis.";
                 			}
                 			return "LOWEST ENERGY CONSUMPTION\n" + "Energy: " + lowestEnergy + " kWh\n" + "Record ID: " + lowestID;
                 		}
                 		if(q.contains("average") || q.contains("mean"))
                 		{
                 			return "AVERAGE ENERGY CONSUMPTION\n" + "Average: " + energyAverage + " kWh per record\n" + "Total energy: " + energyTotal + " kWh\n" + "Records analyzed: " + energyCount;
                 		}
                 		if(q.contains("co2") || q.contains("carbon") || q.contains("emission"))
                 		{
                 			return "CARBON EMISSIONS SUMMARY\n" + "Total estimated CO2: " + co2Total + "\n" + "Records analyzed: " + energyCount;
                 		}
                 		if(q.contains("high consumption") || q.contains("above 500") || q.contains("at least 500"))
                 		{
                 			return "HIGH-CONSUMPTION RECORDS\n" + "Records consuming at least 500 kWh: " + highCount;
                 		}
                 		return "CAMPUS ENERGY SUMMARY\n" + "Total energy: " + energyTotal + " kWh\n" + "Total estimated CO2: " + co2Total + "\n" + "Energy records: " + energyCount + "\n" + "Average energy: " + energyAverage + " kWh\n" + "Highest consumption: " + highestEnergy + " kWh\n" + "Lowest consumption: " + lowestEnergy + " kWh\n" + "High-consumption records: " + highCount;
                 	}
                 	// =====================================
                 	// 11. GENERAL SUSTAINABILITY
                 	// =====================================
                 	if(q.contains("sustainability") || q.contains("environment") || q.contains("eco-friendly") || q.contains("green campus"))
                 	{
                 		return "CAMPUS SUSTAINABILITY OVERVIEW\n" + "Total energy: " + energyTotal + " kWh\n" + "Estimated CO2: " + co2Total + "\n" + "Energy records: " + energyCount + "\n\n" + "You can ask about electricity conservation, water saving, " + "waste reduction, green activities, student participation, " + "or sustainability complaints.";
                 	}
                 	// =====================================
                 	// 12. GENERAL FALLBACK
                 	// =====================================
                 	return "I could not match that question to a supported topic.\n" + "Try asking:\n" + "- How can we save electricity?\n" + "- How can we reduce carbon emissions?\n" + "- How can we save water?\n" + "- How can we reduce waste?\n" + "- Suggest green campus activities.\n" + "- Show energy consumption records.\n" + "- What is the average energy consumption?";
                 }
				 string getOpenAIAnswer(string question)
                 {
                 	if(question == null || question.trim() == "")
                 	{
                 		return "Please enter a sustainability question.";
                 	}
                 	return thisapp.askCampusAI(question);
                 }
				 string getSustainabilityInsights()
                 {
                 	totalEnergy = 0.0;
                 	totalCO2 = 0.0;
                 	recordCount = 0;
                 	highUsageCount = 0;
                 	for each  rec in Energy_Consumption[ID != 0]
                 	{
                 		energy = ifnull(rec.Units_Consumed_kWh,0.0);
                 		co2 = ifnull(rec.Estimated_CO,0.0);
                 		totalEnergy = totalEnergy + energy;
                 		totalCO2 = totalCO2 + co2;
                 		recordCount = recordCount + 1;
                 	}
                 	averageEnergy = 0.0;
                 	if(recordCount > 0)
                 	{
                 		averageEnergy = totalEnergy / recordCount;
                 	}
                 	for each  rec in Energy_Consumption[ID != 0]
                 	{
                 		energy = ifnull(rec.Units_Consumed_kWh,0.0);
                 		if(averageEnergy > 0 && energy > averageEnergy * 1.5)
                 		{
                 			highUsageCount = highUsageCount + 1;
                 		}
                 	}
                 	result = "CAMPUS SUSTAINABILITY ANALYTICS\n\n";
                 	result = result + "Total energy consumption: " + totalEnergy + " kWh\n";
                 	result = result + "Total estimated CO2: " + totalCO2 + "\n";
                 	result = result + "Energy records analyzed: " + recordCount + "\n";
                 	result = result + "Average energy per record: " + averageEnergy + " kWh\n";
                 	result = result + "High-consumption records: " + highUsageCount + "\n\n";
                 	if(recordCount == 0)
                 	{
                 		result = result + "Recommendation: Add energy consumption records to begin analysis.";
                 	}
                 	else if(highUsageCount > 0)
                 	{
                 		result = result + "Recommendation: Review records above 150% of the average energy consumption. Investigate lighting, air conditioning, and equipment usage.";
                 	}
                 	else
                 	{
                 		result = result + "Recommendation: No records exceed the high-consumption threshold. Continue monitoring energy usage.";
                 	}
                 	return result;
                 }
				 float getTotalEnergy()
                 {
                 	total_energy = Energy_Consumption.sum(Units_Consumed_kWh);
                 	return total_energy;
                 }
				 string testOpenAIConnection()
                 {
                 	response = invokeurl
                 	[
                 		url :"https://api.openai.com/v1/models"
                 		type :GET
                 		connection:"openai_sustainability_connection"
                 	];
                 	return response.toString();
                 }
			 }
		 }


		workflow
		{
		form
		{
			Calculate_Recycling_Perce as "Calculate Recycling Percentage"
			{
				type =  form
				form = Waste_Management

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Total_Waste_kg > 0)
										{
											input.Recycling_Percentage = input.Recycled_Quantity_kg / input.Total_Waste_kg * 100;
										}
										else
										{
											input.Recycling_Percentage = 0;
										}
						)
					}
				}

			}
			Calculate_Estimated_CO2 as "Calculate Estimated CO2"
			{
				type =  form
				form = Energy_Consumption

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Units_Consumed_kWh > 0)
										{
											input.Estimated_CO = input.Units_Consumed_kWh * 0.82;
										}
										else
										{
											input.Estimated_CO = 0;
										}
						)
					}
				}

			}
			High_Energy_Consumption_A as "High Energy Consumption Alert"
			{
				type =  form
				form = Energy_Consumption

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Units_Consumed_kWh > 1000)
										{
											alert "High Energy Consumption! Please review this building's energy usage.";
											cancel submit;
										}
						)
					}
				}

			}
			Energy_Status as "Energy Status"
			{
				type =  form
				form = Energy_Consumption

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Units_Consumed_kWh > 1000)
										{
											input.Energy_Status = "High Consumption";
										}
										else
										{
											input.Energy_Status = "Normal";
										}
						)
					}
				}

			}
			Campus_Sustainability_AI_ as "Campus Sustainability AI Assistant"
			{
				type =  form
				form = Campus_Sustainability_AI_Assistant

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											questionText = ifnull(input.User_Question,"");
										if(questionText.trim() != "")
										{
											input.Assistant_Answer = thisapp.askCampusAI(questionText);
										}
										else
										{
											input.Assistant_Answer = "Please enter a question.";
										}
										input.Asked_At = zoho.currenttime;
						)
					}
				}

			}
			Display_AI_Answer as "Display AI Answer"
			{
				type =  form
				form = Campus_Sustainability_AI_Assistant

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											questionText = ifnull(input.User_Question,"");
										if(questionText.trim() != "")
										{
											input.Assistant_Answer = thisapp.getOpenAIAnswer(questionText);
										}
										else
										{
											input.Assistant_Answer = "Please enter a question.";
										}
										input.Asked_At = zoho.currenttime;
						)
					}
				}

			}
			Direct_to_Form_Properties as "Direct to - Form Properties"
			{
				type =  presuccess
				form = Campus_Sustainability_AI_Assistant
				on start
				{
					actions 
					{
						openURL("http://https://creatorapp.zoho.in/kanishka.s.2024.cse_rajal703/smart-campus-sustainability-carbon-tracker/#Report:Campus_Sustainability_AI_Assistant_Report","new window");
					}
				}
			}
			Open_Sustainability_Repor as "Open Sustainability Report"
			{
				type =  form
				form = Campus_Sustainability_AI_Assistant

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											openUrl("#Report:Campus_Sustainability_AI_Assistant_Report","same window");
						)
					}
				}

			}
			Send_Sustainability_Compl as "Send Sustainability Complaint to Zoho CRM"
			{
				type =  form
				form = Sustainability_Complaints

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											crm_response = zoho.crm.createRecord("Contacts",{"Last_Name":input.Reported_By,"Email":input.Email,"Description":"Complaint ID: " + input.Complaint_ID + "\nLocation: " + input.Building_Location + "\nCategory: " + input.Complaint_Category + "\nDetails: " + input.Description + "\nPriority: " + input.Priority},Map());
										info crm_response;
						)
					}
				}

			}
			Send_Chatbot_Answer_to_St as "Send Chatbot Answer to Student Email"
			{
				type =  form
				form = Campus_Sustainability_AI_Assistant

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :"kanishka.s.2024.cse@rajalakshmi.edu.in"
											to :input.Student_Email
											subject :"Campus Sustainability Assistant - Your Answer"
											message :"Hello Student,\n\nThank you for using the Campus Sustainability AI Assistant.\n\nYour Question:\n" + input.User_Question + "\n\nOur Assistant's Answer:\n" + input.Assistant_Answer + "\n\nRegards,\nSmart Campus Sustainability Team"
										]
						)
					}
				}

			}
		}






