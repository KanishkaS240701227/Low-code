 application "Smart Campus Sustainability & Carbon Tracker"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Buildings
		{
			success message = "Building Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Building_ID
			(
    			type = text
				displayname = "Building ID"
				maxchar = 10
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Building_Name
			(
    			type = text
				displayname = "Building Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Block
			(
				type = picklist
				maxchar = 100
				values = {"Academic","Administrative","Hostel","Library","Laboratory","Sports","Canteen","Other"}
				initial value = "Hostel"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Department
			(
    			type = text
				maxchar = 50
	 			row = 1
	 			column = 1   
				width = medium
			)
			Number_of_Floors
			(
				type = number
				displayname = "Number of Floors"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Occupancy_Capacity
			(
				type = number
				displayname = "Occupancy Capacity"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Building_Status
			(
				type = picklist
				displayname = "Building Status"
				maxchar = 100
				values = {"Active","Under Maintenance","Inactive"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Campus_Sustainability_AI_Assistant
		{
			displayname = "Campus Sustainability AI Assistant"
			success message = "Your sustainability question has been submitted successfully. Please check the AI Assistant report for the response."
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			User_Question
			(
    			type = textarea
				displayname = "Your Question"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Assistant_Answer
			(
    			type = textarea
				displayname = "Assistant Answer"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Asked_At
			(
    			type = datetime
				displayname = "Asked At"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Student_Email
			(
    			type = email
				displayname = "Student Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Energy_Consumption
		{
			displayname = "Energy Consumption"
			success message = "Energy Consumption Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Energy_Record_ID
			(
    			type = text
				displayname = "Energy Record ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Buildings
			(
				type = picklist	
				values  = Buildings.ID
    			displayformat = [Building_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Date_field
			(
    			type = date
				displayname = "Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meter_Reading
			(
				type = number
				displayname = "Meter Reading"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Units_Consumed_kWh
			(
				type = number
				displayname = "Units Consumed (kWh)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Electricity_Cost
			(
				displayname = "Electricity Cost"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Estimated_CO
			(
				type = decimal
				displayname = "Estimated CO₂"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Energy_Status
			(
				type = picklist
				displayname = "Energy Status"
				maxchar = 100
				values = {"Normal","High Consumption"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Green_Activities
		{
			displayname = "Green Activities"
			success message = "Green Activity Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Activity_ID
			(
    			type = text
				displayname = "Activity ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Activity_Name
			(
    			type = text
				displayname = "Activity Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Activity_Type
			(
				type = picklist
				displayname = "Activity Type"
				maxchar = 100
				values = {"Tree Plantation","Campus Cleaning","E-Waste Collection","Plastic-Free Campaign","Awareness Program","Energy Conservation","Water Conservation","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Date_field
			(
    			type = date
				displayname = "Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Building_Location
			(
				type = picklist	
				displayname = "Building/Location"
				values  = Buildings.ID
    			displayformat = [Building_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Department
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Number_of_Participants
			(
				type = number
				displayname = "Number of Participants"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Trees_Planted
			(
				type = number
				displayname = "Trees Planted"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Waste_Collected_kg
			(
				type = decimal
				displayname = "Waste Collected (kg)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Student_Participation
		{
			displayname = "Student Participation"
			success message = "Student Participation Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Participation_ID
			(
    			type = text
				displayname = "Participation ID"
				maxchar = 10
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Student_ID
			(
    			type = text
				displayname = "Student ID"
				maxchar = 10
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Student_Name
			(
    			type = text
				displayname = "Student Name"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Department
			(
				type = picklist
				maxchar = 100
				values = {"CSE","IT","ECE","EEE","MECHANICAL","CIVIL","OTHER"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Green_Activities
			(
				type = picklist	
				displayname = "Green Activities"
				values  = Green_Activities.ID
    			displayformat = [Activity_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			dATE_field1
			(
    			type = date
				displayname = "Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Participation_Type
			(
				type = picklist
				displayname = "Participation Type"
				maxchar = 100
				values = {"Volunteer","Participant","Organizer","Coordinator"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Green_Points
			(
				type = number
				displayname = "Green Points"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Sustainability_Complaints
		{
			displayname = "Sustainability Complaints"
			success message = "Sustainability Complaint Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Complaint_ID
			(
    			type = text
				displayname = "Complaint ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Reported_By
			(
    			type = text
				displayname = "Reported By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Building_Location
			(
				type = picklist	
				displayname = "Building/Location"
				values  = Buildings.ID
    			displayformat = [Building_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Complaint_Category
			(
				type = picklist
				displayname = "Complaint Category"
				maxchar = 100
				values = {"Water Leakage","Excess Electricity","Waste Overflow","Plastic Waste","Broken Lights","E-Waste","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Date_Reported
			(
    			type = date
				displayname = "Date Reported"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Priority
			(
				type = picklist
				maxchar = 100
				values = {"High","Medium","Low"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Assigned_To
			(
    			type = text
				displayname = "Assigned To"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = picklist
				maxchar = 100
				values = {"New","Assigned","In Progress","Resolved","Closed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resolution
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resolution_Date
			(
    			type = date
				displayname = "Resolution Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Waste_Management
		{
			displayname = "Waste Management"
			success message = "Waste Management Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Waste_Record_ID
			(
    			type = text
				displayname = "Waste Record ID"
				maxchar = 10
	 			row = 1
	 			column = 1   
				width = medium
			)
			Buildings
			(
				type = picklist	
				values  = Buildings.ID
    			displayformat = [Building_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Date_field
			(
    			type = date
				displayname = "Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Waste_Type
			(
				type = picklist
				displayname = "Waste Type"
				maxchar = 100
				values = {"Food Waste","Plastic","Paper","E-Waste","Metal","Glass","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Total_Waste_kg
			(
				type = decimal
				displayname = "Total Waste (kg)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Recycled_Quantity_kg
			(
				type = decimal
				displayname = "Recycled Quantity (kg)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Disposal_Method
			(
				type = picklist
				displayname = "Disposal Method"
				maxchar = 100
				values = {"Recycled","Composted","Landfill","Incinerated","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Recycling_Percentage
			(
				type = decimal
				displayname = "Recycling Percentage"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Water_Consumption
		{
			displayname = "Water Consumption"
			success message = "Water Consumption Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Water_Record_ID
			(
    			type = text
				displayname = "Water Record ID"
				maxchar = 50
	 			row = 1
	 			column = 1   
				width = medium
			)
			Buildings
			(
				type = picklist	
				values  = Buildings.ID
    			displayformat = [Building_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Date_field
			(
    			type = date
				displayname = "Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Water_Used_Litres
			(
				type = number
				displayname = "Water Used (Litres)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Water_Source
			(
				type = picklist
				displayname = "Water Source"
				maxchar = 100
				values = {"Municipal","Borewell","Tanker","Rainwater","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Water_Cost
			(
				displayname = "Water Cost"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Water_Cost_Prediction
			(
				type = decimal
				displayname = "Water Cost Prediction"
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = Prediction
									modelname = "Water_Consumption_Model"
									supportingfield = {Water_Source,Water_Used_Litres}
						)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Buildings
		{
			displayName = "All Buildings"
			show all rows from Buildings    
			(
				Building_ID as "Building ID"
				Building_Name as "Building Name"
				Block
				Department
				Number_of_Floors as "Number of Floors"
				Occupancy_Capacity as "Occupancy Capacity"
				Building_Status as "Building Status"
			)
		}
		default list All_Energy_Consumptions
		{
			displayName = "All Energy Consumptions"
			show all rows from Energy_Consumption    
			(
				Energy_Record_ID as "Energy Record ID"
				Buildings
				Date_field as "Date"
				Meter_Reading as "Meter Reading"
				Units_Consumed_kWh as "Units Consumed (kWh)"
				Electricity_Cost as "Electricity Cost"
				Estimated_CO as "Estimated CO₂"
				Energy_Status as "Energy Status"
			)
		}
		default list All_Water_Consumptions
		{
			displayName = "All Water Consumptions"
			show all rows from Water_Consumption    
			(
				Water_Record_ID as "Water Record ID"
				Buildings
				Date_field as "Date"
				Water_Used_Litres as "Water Used (Litres)"
				Water_Source as "Water Source"
				Water_Cost as "Water Cost"
				Water_Cost_Prediction as "Water Cost Prediction"
			)
		}
		default list All_Waste_Management
		{
			displayName = "All Waste Management"
			show all rows from Waste_Management    
			(
				Waste_Record_ID as "Waste Record ID"
				Buildings
				Date_field as "Date"
				Waste_Type as "Waste Type"
				Total_Waste_kg as "Total Waste (kg)"
				Recycled_Quantity_kg as "Recycled Quantity (kg)"
				Disposal_Method as "Disposal Method"
				Recycling_Percentage as "Recycling Percentage"
			)
		}
		default list All_Green_Activities
		{
			displayName = "All Green Activities"
			show all rows from Green_Activities    
			(
				Activity_ID as "Activity ID"
				Activity_Name as "Activity Name"
				Activity_Type as "Activity Type"
				Date_field as "Date"
				Building_Location as "Building/Location"
				Department
				Number_of_Participants as "Number of Participants"
				Trees_Planted as "Trees Planted"
				Waste_Collected_kg as "Waste Collected (kg)"
				Description
			)
		}
		default list All_Sustainability_Complaints
		{
			displayName = "All Sustainability Complaints"
			show all rows from Sustainability_Complaints    
			(
				Complaint_ID as "Complaint ID"
				Reported_By as "Reported By"
				Email
				Building_Location as "Building/Location"
				Complaint_Category as "Complaint Category"
				Description
				Date_Reported as "Date Reported"
				Priority
				Assigned_To as "Assigned To"
				Status
				Resolution
				Resolution_Date as "Resolution Date"
			)
		}
		default list All_Student_Participations
		{
			displayName = "All Student Participations"
			show all rows from Student_Participation    
			(
				Participation_ID as "Participation ID"
				Student_ID as "Student ID"
				Student_Name as "Student Name"
				Department
				Green_Activities as "Green Activities"
				dATE_field1 as "Date"
				Participation_Type as "Participation Type"
				Green_Points as "Green Points"
			)
		}
		kanban Energy_Consumption_Report
		{
			displayName = "Energy Consumption Report"
			show all rows from Energy_Consumption    
			(
				Energy_Record_ID as "Energy Record ID"
				Buildings
				(
					view = All_Buildings
				)
				Date_field as "Date"
				Meter_Reading as "Meter Reading"
				Units_Consumed_kWh as "Units Consumed (kWh)"
				Electricity_Cost as "Electricity Cost"
				Estimated_CO as "Estimated CO₂"
				Energy_Status as "Energy Status"
			)
			options
			(
	 			display field = Buildings
				sort order  = ascending
	 		)
		}
		list Waste_Management_Report
		{
			displayName = "Waste Management Report"
			show all rows from Waste_Management    
			(
				Waste_Record_ID as "Waste Record ID"
				Buildings
				Date_field as "Date"
				Waste_Type as "Waste Type"
				Total_Waste_kg as "Total Waste (kg)"
				Recycled_Quantity_kg as "Recycled Quantity (kg)"
				Disposal_Method as "Disposal Method"
				Recycling_Percentage as "Recycling Percentage"
			)
		}
		default list Campus_Sustainability_AI_Assistant_Report
		{
			displayName = "Campus Sustainability AI Assistant Report"
			show all rows from Campus_Sustainability_AI_Assistant    
			(
				User_Question as "Your Question"
				Assistant_Answer as "AI Response"
				Asked_At as "Asked At"
				Student_Email as "Student Email"
			)
		}
		pivotchart Water_Consumption_Report
		{
			displayname = "Water Consumption Report"
			based on Autoview_1792234222338_Water_Consumption
				show all rows from Water_Consumption
				(
			Water_Record_ID  as "Water Record ID"
			Buildings 
			Date_field  as "Date"
			Water_Used_Litres  as "Water Used (Litres)"
			Water_Source  as "Water Source"
			Water_Cost  as "Water Cost"
			Water_Cost_Prediction  as "Water Cost Prediction"
				)
		}
		pivottable Green_Activities_Report
		{
			displayname = "Green Activities Report"
			based on Autoview_1792234809516_Green_Activities
				show all rows from Green_Activities
				(
			Activity_ID  as "Activity ID"
			Activity_Name  as "Activity Name"
			Activity_Type  as "Activity Type"
			Date_field  as "Date"
			Building_Location  as "Building/Location"
			Department 
			Number_of_Participants  as "Number of Participants"
				)
		}
	}
	pages
	{
		page Sustainability_Dashboard
		{
			displayname = "Sustainability Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Chart'\n\n\ttype = 'Column'\n\txtitle = 'Building Name'\n\tytitle = 'Units Consumed (kWh)'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Energy_Consumption'\n\txfield = 'Buildings.Building_Name'\n\tyfields = 'sum:Units_Consumed_kWh'\n\tshowDataLabel = 'true'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Chart 1'\n\n\ttype = 'Bar'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Water_Consumption'\n\txfield = 'Buildings.Building_Name'\n\tyfields = 'sum:Water_Used_Litres'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<gauge \n\telementName='Gauge'\n\n\tcolor = '#000000'\n\tsize = '20px'\n\tfontFamily = 'default' \n\tbgColor = '#FFFFFF'\n\ttheme = '#0BD6B1'\n\tdisplayType = 'actual'\n\ttype = '1'\n\tfilledColor = '#0BD6B1'\n\tnonFilledColor = '#F5F5F5'\n\tneedleColor = '#000000'\n\ttargetColor = '#D8D8D8'\n\tvalue = 'thisapp.Energy_Consumption.Estimated_CO.avg'\n>\n<target size=\"15px\" color=\"#7F7F7F\" fontFamily=\"default\" value=\"3000\"\n/><maximumvalue size=\"15px\" color=\"#7F7F7F\" value=\"5000\" \n/>\n</gauge>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'New employees this month'\n